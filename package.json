{
  "name": "infra-beatbox",
  "version": "0.1.0",
  "private": true,
  "description": "A grid of tones and rhythms on one scale: the C major scale for pitch, and the same scale eight octaves lower, around 1 Hz, for rhythm.",
  "author": "Bartosz Sułkowski (https://bsulkowski.pl)",
  "type": "module",
  "exports": {
    ".": "./src/infra-beatbox.ts",
    "./player": "./src/player.ts"
  },
  "types": "./src/infra-beatbox.ts",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/infra-beatbox.test.ts",
    "demo": "esbuild demo/main.ts --bundle --format=esm --outdir=demo --servedir=demo --serve=8000"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
